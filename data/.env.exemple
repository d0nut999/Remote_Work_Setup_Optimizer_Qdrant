# Qdrant Configuration
# Get these from your Qdrant Cloud dashboard: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ML Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEVICE=cpu

# Data Sources
PRODUCTS_DATA_PATH=../data/products.json
ENABLE_SCRAPING=False
